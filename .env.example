# ==========================================
# PlacementIQ Environment Variables Example
# ==========================================

# --- LLM Provider (OpenRouter) ---
# Required for resume parsing, JD decoding, and report building
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# --- Scraping Provider (Apify) ---
# Required for running parallel actors (Glassdoor, AmbitionBox, LinkedIn, College Data)
# Get your token from: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_your_apify_token_here

# --- ZyndAI Network ---
# Used for agent orchestration and deployment
ZYND_REGISTRY_URL=https://zns01.zynd.ai
